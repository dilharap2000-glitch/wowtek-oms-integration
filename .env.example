# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string.
# If omitted or if connection fails/times out, WOWTEK Pro operates safely in Mock DB fallback mode.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="wowtek_pro"

# Trans Express Courier Integration
TRANS_EXPRESS_API_URL="https://v2.transexpress.lk"
TRANS_EXPRESS_API_KEY="your_trans_express_api_key_here"
TRANS_EXPRESS_CLIENT_TOKEN="your_trans_express_api_key_here"

